# Copy to .env and fill in. .env is gitignored and must never be committed.
# Only needed for the "ollama" and "anthropic" backends — the default
# "template" backend runs with no configuration at all.

# Which generation backend to use: template | ollama | anthropic
LISTING_BACKEND=template

# Anthropic backend
ANTHROPIC_API_KEY=
LISTING_LLM_MODEL=claude-sonnet-5

# Ollama backend (LISTING_LLM_MODEL doubles as the Ollama model name)
OLLAMA_HOST=http://localhost:11434
